# Copia este archivo a backend/.env y ajústalo.
# URL base de Florida Oberta (Moodle), sin barra final.
MOODLE_BASE_URL=https://www.floridaoberta.com

# Cómo se inicia sesión:
#   auto      -> usa el botón de Microsoft/Office 365 si existe; si no, el formulario de Moodle
#   microsoft -> siempre Microsoft (Office 365)
#   moodle    -> formulario propio de Moodle
LOGIN_MODE=auto
# Tiempo máximo (s) para completar el login, incluida la aprobación en Microsoft Authenticator
LOGIN_TIMEOUT_S=180
# Responder "Sí" a "¿Quiere mantener la sesión iniciada?" de Microsoft (menos MFA repetidas)
MS_STAY_SIGNED_IN=true
# Días que se conserva la sesión cifrada en el PC antes de borrarse sola
SESSION_MAX_DAYS=14

# true = navegador oculto; false = ver Chromium en el PC (necesario para "login manual")
MOODLE_HEADLESS=true
# Tiempo máximo por acción de Playwright (ms)
MOODLE_TIMEOUT_MS=30000

# Código de acceso que la tablet debe introducir una vez. Si lo dejas vacío se genera uno
# aleatorio, se guarda en data/access_code y se muestra en la consola al arrancar.
APP_ACCESS_TOKEN=
# Carpeta de datos locales (BD, clave, sesión). Por defecto backend/data
# APP_DATA_DIR=

# --- Evaluación automática con IA (opcional; requiere autorización del DPD de Florida) ---
# Clave de la API de Claude (https://console.anthropic.com). Sin ella no se evalúa.
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-opus-5-5)
# AUTO_EVAL_MODEL=claude-opus-5-5
# Hoja de Google a actualizar (ver integraciones/google-sheets.gs)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=
